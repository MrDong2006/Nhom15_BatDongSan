<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BĐS VIỆT Hub | Nhóm 15</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <!-- Project CSS -->
    <link rel="stylesheet" href="~/css/style.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen flex flex-col">

    <!-- Top Announcement Bar -->
    <div class="bg-gradient-to-r from-blue-700 via-indigo-700 to-blue-800 text-white text-xs py-2 px-4 shadow-inner">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2 overflow-hidden">
                <span class="bg-rose-500 text-white text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-full flex-shrink-0 animate-pulse">ASP.NET CORE</span>
                <p class="truncate text-slate-100">
                    Đồ án môn Phát triển ứng dụng Web - Nhóm 15 | Hotline hỗ trợ 24/7: <strong class="text-white underline">1900 6868</strong>
                </p>
            </div>
            <div class="hidden md:flex items-center gap-4 text-slate-200 text-xs flex-shrink-0">
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-server text-emerald-400"></i> Kestrel .NET Server</span>
                <span class="flex items-center gap-1.5"><i class="fa-solid fa-database text-blue-300"></i> SQL Server / EF Core</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16 sm:h-20">
                
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 group flex-shrink-0">
                    <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-blue-700 to-indigo-500 flex items-center justify-center text-white text-lg shadow-md shadow-blue-500/20 group-hover:scale-105 transition-transform">
                        <i class="fa-solid fa-city"></i>
                    </div>
                    <div>
                        <div class="text-lg sm:text-xl font-black tracking-tight text-slate-900 flex items-center gap-1 leading-tight">
                            <span>BĐS</span><span class="text-blue-600">VIỆT</span>
                            <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-100 text-blue-700 font-bold uppercase ml-1">MVC</span>
                        </div>
                        <div class="text-[10px] text-slate-400 font-medium tracking-wide">NHÓM 15 - ASP.NET CORE</div>
                    </div>
                </a>

                <!-- Desktop Menu -->
                <nav class="hidden lg:flex items-center gap-1 text-sm font-semibold text-slate-600">
                    <a asp-controller="Home" asp-action="Index" class="px-3 py-2 rounded-xl hover:text-blue-600 hover:bg-slate-50 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-house text-xs text-blue-600"></i> Trang chủ
                    </a>
                    <a asp-controller="Property" asp-action="Index" class="px-3 py-2 rounded-xl hover:text-blue-600 hover:bg-slate-50 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-list text-xs"></i> Nhà đất
                    </a>
                    <a asp-controller="Property" asp-action="MapSearch" class="px-3 py-2 rounded-xl hover:text-blue-600 hover:bg-slate-50 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-map-location-dot text-rose-500 text-xs"></i> Bản đồ số
                    </a>
                    <a asp-controller="Property" asp-action="Projects" class="px-3 py-2 rounded-xl hover:text-blue-600 hover:bg-slate-50 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-building text-xs"></i> Dự án
                    </a>
                    <a asp-controller="Home" asp-action="LoanCalculator" class="px-3 py-2 rounded-xl hover:text-blue-600 hover:bg-slate-50 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-calculator text-xs"></i> Tính lãi vay
                    </a>
                    <a asp-controller="Contact" asp-action="Index" class="px-3 py-2 rounded-xl hover:text-blue-600 hover:bg-slate-50 transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-headset text-xs"></i> Liên hệ
                    </a>
                    <a asp-controller="Admin" asp-action="Index" class="px-3 py-2 rounded-xl text-indigo-700 bg-indigo-50 hover:bg-indigo-100 font-bold transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-shield-halved text-xs"></i> Quản trị
                    </a>
                </nav>

                <!-- Actions -->
                <div class="flex items-center gap-3 flex-shrink-0">
                    <a asp-controller="Property" asp-action="Post" class="px-4 py-2.5 rounded-xl text-xs sm:text-sm font-bold bg-blue-600 hover:bg-blue-700 text-white shadow-md shadow-blue-600/20 transition-all flex items-center gap-2">
                        <i class="fa-solid fa-circle-plus"></i>
                        <span>Đăng tin</span>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Notification Toast -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="max-w-7xl mx-auto px-4 mt-4 w-full">
            <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-semibold flex items-center justify-between shadow-sm">
                <div class="flex items-center gap-3">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-lg"></i>
                    <span>@TempData["SuccessMessage"]</span>
                </div>
                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-800">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
    }

    <!-- Main Content -->
    <main class="flex-1">
        @RenderBody()
    </main>

    <!-- Universal Footer -->
    <footer class="bg-slate-900 text-slate-300 pt-12 pb-8 border-t border-slate-800 mt-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
                <div>
                    <div class="text-white font-black text-lg mb-3 flex items-center gap-2">
                        <i class="fa-solid fa-city text-blue-500"></i>
                        <span>BĐS VIỆT Hub - Nhóm 15</span>
                    </div>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        Hệ thống Cổng thông tin và sàn giao dịch Bất Động Sản Toàn diện. Dự án môn học Phát triển ứng dụng Web xây dựng trên nền tảng ASP.NET Core MVC & C#.
                    </p>
                </div>
                <div>
                    <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Tính Năng Đồ Án</h4>
                    <ul class="space-y-2 text-xs text-slate-400">
                        <li><a asp-controller="Property" asp-action="Index" class="hover:text-blue-400">Tra cứu BĐS đa tiêu chí</a></li>
                        <li><a asp-controller="Property" asp-action="MapSearch" class="hover:text-blue-400">Bản đồ số định vị GPS</a></li>
                        <li><a asp-controller="Home" asp-action="LoanCalculator" class="hover:text-blue-400">Công cụ tính lãi vay ngân hàng</a></li>
                        <li><a asp-controller="Admin" asp-action="Index" class="hover:text-blue-400">Quản trị Admin & Quản lý ảnh</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Bài Thực Hành Môn Học</h4>
                    <ul class="space-y-2 text-xs text-slate-400">
                        <li><a asp-controller="Admin" asp-action="Index" class="hover:text-blue-400">Bài TH 10: Quản lý sản phẩm</a></li>
                        <li><a asp-controller="Admin" asp-action="ManageImages" asp-route-propertyId="10" class="hover:text-blue-400">Bài TH 11: Quản lý ảnh sản phẩm</a></li>
                        <li><a asp-controller="Contact" asp-action="Index" class="hover:text-blue-400">Bài TH 12: Gửi liên hệ & tư vấn</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-white font-bold text-xs uppercase tracking-wider mb-3">Trụ Sở & Chi Nhánh</h4>
                    <p class="text-xs text-slate-400 leading-relaxed mb-2">
                        <strong>Cần Thơ:</strong> 10°02'02.8"N 105°47'15.0"E (Bến Ninh Kiều)
                    </p>
                    <p class="text-xs text-slate-400 leading-relaxed">
                        <strong>Hotline:</strong> 1900 6868
                    </p>
                </div>
            </div>
            <div class="pt-6 border-t border-slate-800 text-center text-xs text-slate-500">
                © 2026 Nhóm 15 - Môn Phát Triển Ứng Dụng Web | ASP.NET Core MVC
            </div>
        </div>
    </footer>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
