@model Nhom15_BatDongSan.Models.ContactInquiry
@{
    ViewData["Title"] = "Liên Hệ & Tổng Đài Hỗ Trợ - Bài Thực Hành 12";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

    <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold uppercase">
            Bài Thực Hành 12: Gửi Liên Hệ
        </span>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">Trung Tâm Tiếp Nhận & Hỗ Trợ 24/7</h1>
        <p class="text-xs sm:text-sm text-slate-500">
            Gửi yêu cầu tư vấn mua bán nhà đất, kiểm tra quy hoạch pháp lý hoặc lịch hẹn xem nhà trực tiếp.
        </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Form Cột 5 -->
        <div class="lg:col-span-5 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
            <div class="pb-3 border-b border-slate-100">
                <h2 class="text-base font-extrabold text-slate-900">Mẫu Gửi Yêu Cầu Liên Hệ</h2>
                <p class="text-xs text-slate-400 mt-0.5">Dữ liệu được lưu trữ trực tiếp vào CSDL hệ thống</p>
            </div>

            <form method="post" asp-controller="Contact" asp-action="Index" class="space-y-4">
                @Html.AntiForgeryToken()

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="p-3 rounded-xl bg-rose-50 text-rose-700 text-xs">
                        @Html.ValidationSummary(true)
                    </div>
                }

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Họ và tên của bạn *</label>
                    <input type="text" name="FullName" value="@Model?.FullName" required placeholder="Ví dụ: Trần Văn An" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Số điện thoại *</label>
                        <input type="tel" name="Phone" value="@Model?.Phone" required placeholder="09xx xxx xxx" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Địa chỉ Email</label>
                        <input type="email" name="Email" value="@Model?.Email" placeholder="email@gmail.com" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Nội dung quan tâm</label>
                    <select name="Topic" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                        <option value="buy">Tư vấn tìm mua nhà đất / căn hộ</option>
                        <option value="post">Hỗ trợ ký gửi bán / cho thuê</option>
                        <option value="valuation">Thẩm định giá thị trường & khảo sát</option>
                        <option value="legal">Kiểm tra pháp lý sổ đỏ / quy hoạch</option>
                        <option value="loan">Tư vấn gói vay ngân hàng</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Chi nhánh tiếp nhận</label>
                    <select name="Branch" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                        <option value="cantho">Chi nhánh Cần Thơ (10.0341, 105.7875)</option>
                        <option value="hcm">Trụ sở TP. Hồ Chí Minh (Landmark 81)</option>
                        <option value="hn">Chi nhánh Hà Nội (Keangnam Landmark 72)</option>
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Lời nhắn chi tiết</label>
                    <textarea name="Message" rows="3" placeholder="Nêu rõ nhu cầu tìm kiếm hoặc câu hỏi của bạn..." class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">@Model?.Message</textarea>
                </div>

                <div class="flex items-center gap-2 text-[11px] text-slate-500">
                    <input type="checkbox" name="Consent" value="true" checked required class="rounded text-blue-600 focus:ring-blue-500" />
                    <label>Tôi đồng ý để chuyên viên liên hệ giải đáp qua số điện thoại này</label>
                </div>

                <button type="submit" class="w-full py-3.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-2xl text-xs transition-all shadow-lg shadow-blue-600/25 flex items-center justify-center gap-2">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>Gửi Yêu Cầu Liên Hệ Ngay</span>
                </button>
            </form>
        </div>

        <!-- Bản đồ và Chi nhánh Cột 7 -->
        <div class="lg:col-span-7 space-y-6">
            
            <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-extrabold text-slate-900">Chi Nhánh & Trụ Sở Giao Dịch</h3>
                        <p class="text-xs text-slate-400">Văn phòng chính tại TP. Cần Thơ</p>
                    </div>
                    <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-emerald-100 text-emerald-800">
                        Mở cửa: 08:00 - 21:00
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    <div class="p-3.5 rounded-2xl bg-blue-50 border border-blue-200">
                        <div class="font-extrabold text-xs text-blue-900 mb-1">📍 Cần Thơ</div>
                        <div class="text-[11px] text-blue-700 font-mono">10°02'02.8"N 105°47'15.0"E</div>
                        <div class="text-[10px] text-slate-600 mt-1">Đại lộ Hòa Bình, Q. Ninh Kiều</div>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
                        <div class="font-extrabold text-xs text-slate-900 mb-1">TP. Hồ Chí Minh</div>
                        <div class="text-[10px] text-slate-600">Landmark 81, Q. Bình Thạnh</div>
                    </div>
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200">
                        <div class="font-extrabold text-xs text-slate-900 mb-1">Hà Nội</div>
                        <div class="text-[10px] text-slate-600">Keangnam 72, Nam Từ Liêm</div>
                    </div>
                </div>

                <div id="contact-map" class="w-full h-80 rounded-2xl overflow-hidden border border-slate-200"></div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var canthoCoords = [10.0341, 105.7875];
            var map = L.map('contact-map').setView(canthoCoords, 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap contributors'
            }).addTo(map);

            L.marker(canthoCoords).addTo(map)
                .bindPopup('<b>BĐS VIỆT Hub - Chi Nhánh Cần Thơ</b><br>10°02\'02.8"N 105°47\'15.0"E<br>Đại lộ Hòa Bình, Q. Ninh Kiều')
                .openPopup();
        });
    </script>
}
