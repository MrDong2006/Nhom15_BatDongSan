@model List<Nhom15_BatDongSan.Models.Property>
@{
    ViewData["Title"] = "Trang Quản Trị Hệ Thống - Admin Dashboard";
    var contacts = ViewBag.Contacts as List<Nhom15_BatDongSan.Models.ContactInquiry> ?? new();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-100 text-indigo-800">
                ADMINISTRATION PANEL
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-slate-900 mt-1">Bảng Điều Khiển Quản Trị Hệ Thống</h1>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Property" asp-action="Post" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md">
                <i class="fa-solid fa-plus mr-1"></i> Thêm BĐS mới
            </a>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-xl">
                <i class="fa-solid fa-city"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase">Tổng Bất Động Sản</div>
                <div class="text-xl font-black text-slate-900">@ViewBag.TotalProperties</div>
            </div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                <i class="fa-solid fa-envelope-open-text"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase">Yêu cầu liên hệ (TH12)</div>
                <div class="text-xl font-black text-slate-900">@ViewBag.TotalContacts</div>
            </div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
                <i class="fa-solid fa-images"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase">Quản lý ảnh (TH11)</div>
                <div class="text-xl font-black text-slate-900">Sẵn sàng</div>
            </div>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
                <i class="fa-solid fa-users"></i>
            </div>
            <div>
                <div class="text-xs text-slate-400 font-bold uppercase">Môi giới / Chuyên viên</div>
                <div class="text-xl font-black text-slate-900">6</div>
            </div>
        </div>
    </div>

    <!-- Product Management Table (Bài TH 10 & 11) -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div>
                <h2 class="text-base font-extrabold text-slate-900">Danh Sách Bất Động Sản (Bài TH 10: Quản Lý Sản Phẩm)</h2>
                <p class="text-xs text-slate-400">Nhấp "Quản lý ảnh" để thêm/sửa/xóa ảnh sản phẩm (Bài TH 11)</p>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold">
                        <th class="p-3">ID</th>
                        <th class="p-3">Hình ảnh</th>
                        <th class="p-3">Tiêu đề BĐS</th>
                        <th class="p-3">Loại hình</th>
                        <th class="p-3">Giá niêm yết</th>
                        <th class="p-3">Khu vực</th>
                        <th class="p-3 text-center">Ảnh (TH11)</th>
                        <th class="p-3 text-right">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="p-3 font-mono font-bold text-slate-500">#@item.Id</td>
                            <td class="p-3">
                                <img src="@(item.Images.FirstOrDefault() ?? "")" class="w-14 h-10 object-cover rounded-lg border border-slate-200" />
                            </td>
                            <td class="p-3">
                                <div class="font-bold text-slate-900 max-w-xs truncate">@item.Title</div>
                                <div class="text-[10px] text-slate-400 truncate">@item.Address</div>
                            </td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-bold text-[10px]">@item.CategoryName</span>
                            </td>
                            <td class="p-3 font-extrabold text-slate-900">@item.PriceDisplay</td>
                            <td class="p-3 text-slate-600">@item.District</td>
                            <td class="p-3 text-center">
                                <span class="px-2 py-1 rounded-full bg-purple-50 text-purple-700 font-bold text-[11px]">
                                    @item.Images.Count ảnh
                                </span>
                            </td>
                            <td class="p-3 text-right space-x-1">
                                <a asp-controller="Admin" asp-action="ManageImages" asp-route-propertyId="@item.Id" class="px-2.5 py-1.5 rounded-lg bg-purple-50 text-purple-700 font-bold text-[11px] hover:bg-purple-100 transition-colors">
                                    <i class="fa-solid fa-images mr-1"></i> Quản lý ảnh
                                </a>
                                <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" target="_blank" class="px-2.5 py-1.5 rounded-lg bg-slate-100 text-slate-700 font-bold text-[11px] hover:bg-slate-200 transition-colors">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Contact Submissions Table (Bài TH 12) -->
    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm space-y-4">
        <div class="pb-3 border-b border-slate-100">
            <h2 class="text-base font-extrabold text-slate-900">Danh Sách Liên Hệ Khách Hàng (Bài TH 12: Gửi Liên Hệ)</h2>
            <p class="text-xs text-slate-400">Các yêu cầu gửi từ trang liên hệ hoặc trang chi tiết sản phẩm</p>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs">
                <thead>
                    <tr class="border-b border-slate-200 bg-slate-50 text-slate-500 font-bold">
                        <th class="p-3">Họ tên</th>
                        <th class="p-3">Số điện thoại</th>
                        <th class="p-3">Email</th>
                        <th class="p-3">Chủ đề</th>
                        <th class="p-3">Chi nhánh</th>
                        <th class="p-3">Lời nhắn</th>
                        <th class="p-3">Thời gian</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var c in contacts)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="p-3 font-bold text-slate-900">@c.FullName</td>
                            <td class="p-3 font-mono text-blue-600 font-bold">@c.Phone</td>
                            <td class="p-3 text-slate-500">@c.Email</td>
                            <td class="p-3">
                                <span class="px-2 py-0.5 rounded bg-amber-50 text-amber-800 font-semibold text-[10px]">@c.TopicTitle</span>
                            </td>
                            <td class="p-3 uppercase font-bold text-slate-600 text-[10px]">@c.Branch</td>
                            <td class="p-3 text-slate-600 max-w-xs truncate">@c.Message</td>
                            <td class="p-3 text-slate-400 text-[10px]">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
