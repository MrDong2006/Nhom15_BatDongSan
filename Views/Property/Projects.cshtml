@model List<Nhom15_BatDongSan.Models.Project>
@{
    ViewData["Title"] = "Dự Án Đô Thị Nổi Bật";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div>
        <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold uppercase">Khu Đô Thị Toàn Diện</span>
        <h1 class="text-3xl font-black text-slate-900 mt-2">Dự Án Đô Thị & Quần Thể Nghỉ Dưỡng</h1>
        <p class="text-xs sm:text-sm text-slate-500">Các đại dự án quy mô lớn được phân phối chính thức qua sàn BĐS Việt Hub</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        @foreach (var proj in Model)
        {
            <div class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all group flex flex-col justify-between">
                <div class="relative h-64 overflow-hidden bg-slate-900">
                    <img src="@proj.ImageUrl" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <span class="absolute top-4 left-4 px-3 py-1 rounded-full text-xs font-bold text-white @proj.StatusColor shadow-md">
                        @proj.Status
                    </span>
                    <div class="absolute bottom-4 left-4 px-4 py-2 rounded-xl bg-slate-900/80 backdrop-blur-md text-white text-sm font-extrabold">
                        @proj.PriceRange
                    </div>
                </div>

                <div class="p-6 space-y-4">
                    <div>
                        <div class="text-xs font-bold text-blue-600 uppercase">@proj.Type</div>
                        <h3 class="text-xl font-black text-slate-900 mt-1">@proj.Name</h3>
                        <p class="text-xs text-slate-500 mt-1"><i class="fa-solid fa-location-dot text-rose-500 mr-1"></i>@proj.Location</p>
                    </div>

                    <div class="p-3 rounded-2xl bg-slate-50 border border-slate-100 text-xs space-y-1">
                        <div><strong>Chủ đầu tư:</strong> @proj.Investor</div>
                        <div><strong>Quy mô:</strong> @proj.Scale</div>
                    </div>

                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var h in proj.Highlights)
                        {
                            <span class="px-2.5 py-1 rounded-lg bg-blue-50 text-blue-700 text-[11px] font-semibold">
                                <i class="fa-solid fa-check text-[10px] mr-1 text-emerald-500"></i>@h
                            </span>
                        }
                    </div>

                    <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                        <a asp-controller="Contact" asp-action="Index" class="w-full py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs text-center transition-colors">
                            Nhận bảng giá & chính sách ưu đãi
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
