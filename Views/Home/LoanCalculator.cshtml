@model List<Nhom15_BatDongSan.Models.LoanPackage>
@{
    ViewData["Title"] = "Công Cụ Tính Lãi Vay Mua Nhà";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold uppercase">Công Cụ Tài Chính Vay Mua Nhà</span>
        <h1 class="text-3xl font-black text-slate-900">Bảng Tính Lãi Suất Ngân Hàng</h1>
        <p class="text-xs sm:text-sm text-slate-500">Mô phỏng khoản vay mua nhà theo phương thức Dư Nợ Giảm Dần hoặc Trả Đều Hàng Tháng</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Calculator Inputs -->
        <div class="lg:col-span-5 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-5">
            <h2 class="text-base font-extrabold text-slate-900 pb-3 border-b border-slate-100">Thông Số Khoản Vay</h2>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Số tiền vay (Triệu VNĐ)</label>
                <input type="number" id="loan-amount" value="2000" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                <div class="text-[11px] text-slate-400 mt-1">Ví dụ: 2,000 triệu = 2 tỷ đồng</div>
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Thời gian vay (Năm)</label>
                <input type="number" id="loan-years" value="20" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Lãi suất ưu đãi (%/năm)</label>
                <input type="number" step="0.1" id="loan-rate" value="5.5" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-900 focus:ring-2 focus:ring-blue-500 focus:outline-none" />
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-700 mb-1">Phương thức trả nợ</label>
                <select id="loan-method" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                    <option value="reducing">Dư nợ giảm dần (Tiết kiệm lãi nhất)</option>
                    <option value="fixed">Trả đều hàng tháng (Cố định)</option>
                </select>
            </div>

            <button type="button" onclick="calculateLoan()" class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs shadow-md transition-all">
                Tính Toán Khoản Vay
            </button>
        </div>

        <!-- Result Box -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-base font-extrabold text-slate-900 pb-3 border-b border-slate-100">Kết Quả Ước Tính Hàng Tháng</h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="p-4 rounded-2xl bg-blue-50 border border-blue-200">
                    <div class="text-xs text-blue-600 font-bold uppercase">Thanh toán tháng đầu tiên</div>
                    <div id="first-month-payment" class="text-2xl font-black text-blue-900 mt-1">17.5 Triệu VNĐ</div>
                    <div class="text-[11px] text-blue-600 mt-1">Gốc: 8.33 tr + Lãi: 9.17 tr</div>
                </div>

                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200">
                    <div class="text-xs text-slate-500 font-bold uppercase">Tổng tiền lãi phải trả</div>
                    <div id="total-interest" class="text-2xl font-black text-slate-900 mt-1">1,104.5 Triệu VNĐ</div>
                    <div class="text-[11px] text-slate-400 mt-1">Trong suốt 20 năm</div>
                </div>
            </div>

            <!-- Compare Banks -->
            <div>
                <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">Lãi Suất Các Ngân Hàng Hợp Tác</h3>
                <div class="space-y-2">
                    <div class="p-3 rounded-xl bg-slate-50 flex items-center justify-between text-xs">
                        <span class="font-bold text-slate-800">Vietcombank (VCB)</span>
                        <span class="font-black text-emerald-600">5.5% / năm (Cố định 12 tháng)</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-50 flex items-center justify-between text-xs">
                        <span class="font-bold text-slate-800">BIDV</span>
                        <span class="font-black text-emerald-600">6.0% / năm (Cố định 12 tháng)</span>
                    </div>
                    <div class="p-3 rounded-xl bg-slate-50 flex items-center justify-between text-xs">
                        <span class="font-bold text-slate-800">Techcombank</span>
                        <span class="font-black text-emerald-600">6.8% / năm (Cố định 24 tháng)</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function calculateLoan() {
            var P = parseFloat(document.getElementById('loan-amount').value) || 2000;
            var years = parseFloat(document.getElementById('loan-years').value) || 20;
            var r = (parseFloat(document.getElementById('loan-rate').value) || 5.5) / 100 / 12;
            var n = years * 12;

            var principalPerMonth = P / n;
            var firstInterest = P * r;
            var firstPayment = principalPerMonth + firstInterest;

            var totalInterest = (n * (P * r + (P / n) * r)) / 2;

            document.getElementById('first-month-payment').innerText = firstPayment.toFixed(1) + ' Triệu VNĐ';
            document.getElementById('total-interest').innerText = totalInterest.toFixed(1) + ' Triệu VNĐ';
        }
    </script>
}
