@model List<Nhom15_BatDongSan.Models.MarketPrice>
@{
    ViewData["Title"] = "Bảng Giá Thị Trường Bất Động Sản Toàn Quốc 2026";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div>
        <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-xs font-bold uppercase">Dữ Liệu Thống Kê Chuẩn Sàn</span>
        <h1 class="text-3xl font-black text-slate-900 mt-2">Bảng Giá Thị Trường & Biến Động Giá BĐS</h1>
        <p class="text-xs sm:text-sm text-slate-500">Cập nhật đơn giá trung bình (triệu VNĐ/m²) các quận huyện trọng điểm 3 miền</p>
    </div>

    <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs border-collapse">
                <thead>
                    <tr class="bg-slate-50 text-slate-600 font-bold border-b border-slate-200">
                        <th class="p-3.5">Khu vực / Quận Huyện</th>
                        <th class="p-3.5">Căn hộ (tr/m²)</th>
                        <th class="p-3.5">Nhà phố (tr/m²)</th>
                        <th class="p-3.5">Biệt thự (tr/m²)</th>
                        <th class="p-3.5">Đất nền (tr/m²)</th>
                        <th class="p-3.5">Biến động (YoY)</th>
                        <th class="p-3.5">Thanh khoản</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-slate-50 font-medium">
                        <td class="p-3.5 font-bold text-slate-900">TP. Thủ Đức (TP.HCM)</td>
                        <td class="p-3.5 font-extrabold text-blue-600">68 tr/m²</td>
                        <td class="p-3.5">135 tr/m²</td>
                        <td class="p-3.5">275 tr/m²</td>
                        <td class="p-3.5">92 tr/m²</td>
                        <td class="p-3.5 font-bold text-emerald-600">+7.2%</td>
                        <td class="p-3.5"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">Rất cao</span></td>
                    </tr>
                    <tr class="hover:bg-slate-50 font-medium bg-blue-50/30">
                        <td class="p-3.5 font-bold text-slate-900">📍 Quận Ninh Kiều (Cần Thơ)</td>
                        <td class="p-3.5 font-extrabold text-blue-600">42 tr/m²</td>
                        <td class="p-3.5">95 tr/m²</td>
                        <td class="p-3.5">165 tr/m²</td>
                        <td class="p-3.5">48 tr/m²</td>
                        <td class="p-3.5 font-bold text-emerald-600">+6.5%</td>
                        <td class="p-3.5"><span class="px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-bold">Cao</span></td>
                    </tr>
                    <tr class="hover:bg-slate-50 font-medium">
                        <td class="p-3.5 font-bold text-slate-900">Quận Tây Hồ (Hà Nội)</td>
                        <td class="p-3.5 font-extrabold text-blue-600">125 tr/m²</td>
                        <td class="p-3.5">330 tr/m²</td>
                        <td class="p-3.5">460 tr/m²</td>
                        <td class="p-3.5">210 tr/m²</td>
                        <td class="p-3.5 font-bold text-emerald-600">+6.4%</td>
                        <td class="p-3.5"><span class="px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 font-bold">Rất cao</span></td>
                    </tr>
                    <tr class="hover:bg-slate-50 font-medium">
                        <td class="p-3.5 font-bold text-slate-900">Quận Hải Châu (Đà Nẵng)</td>
                        <td class="p-3.5 font-extrabold text-blue-600">78 tr/m²</td>
                        <td class="p-3.5">145 tr/m²</td>
                        <td class="p-3.5">200 tr/m²</td>
                        <td class="p-3.5">98 tr/m²</td>
                        <td class="p-3.5 font-bold text-slate-600">+3.1%</td>
                        <td class="p-3.5"><span class="px-2 py-0.5 rounded bg-slate-100 text-slate-700 font-bold">Ổn định</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
