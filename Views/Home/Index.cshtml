@model List<Nhom15_BatDongSan.Models.Property>
@{
    ViewData["Title"] = "Trang chủ - Sàn Giao Dịch Bất Động Sản";
    var categories = ViewBag.Categories as List<Nhom15_BatDongSan.Models.Category> ?? new();
}

<!-- Hero Section with Search Bar -->
<section class="relative bg-gradient-to-b from-blue-900 via-indigo-900 to-slate-900 text-white pt-12 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="max-w-7xl mx-auto text-center relative z-10">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-xs font-bold mb-4 backdrop-blur-md">
            <i class="fa-solid fa-sparkles"></i>
            <span>CỔNG THÔNG TIN BĐS SỐ 1 - NHÓM 15</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight mb-4">
            Khám Phá Hơn <span class="bg-gradient-to-r from-blue-400 to-teal-300 bg-clip-text text-transparent">10,000+</span> Bất Động Sản Đắc Địa
        </h1>
        <p class="text-sm sm:text-base text-slate-300 max-w-2xl mx-auto mb-8">
            Hệ thống tra cứu, bản đồ số trực quan và bảng giá thị trường chuẩn xác trên nền tảng ASP.NET Core MVC.
        </p>

        <!-- Search Form -->
        <div class="max-w-4xl mx-auto bg-white rounded-3xl p-4 sm:p-5 shadow-2xl text-slate-800">
            <form method="get" asp-controller="Home" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
                <!-- Keyword -->
                <div class="sm:col-span-2">
                    <label class="block text-[11px] font-bold text-slate-500 text-left mb-1">Từ khóa tìm kiếm</label>
                    <div class="relative">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-3.5 text-slate-400 text-xs"></i>
                        <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Nhập tên đường, dự án, khu vực..." class="w-full pl-9 pr-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
                    </div>
                </div>

                <!-- City -->
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 text-left mb-1">Khu vực</label>
                    <select name="city" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none bg-white">
                        <option value="all">Toàn quốc</option>
                        <option value="cantho" selected="@(ViewBag.SelectedCity == "cantho")">Cần Thơ (10.0341, 105.7875)</option>
                        <option value="hcm" selected="@(ViewBag.SelectedCity == "hcm")">TP. Hồ Chí Minh</option>
                        <option value="hn" selected="@(ViewBag.SelectedCity == "hn")">Hà Nội</option>
                        <option value="danang" selected="@(ViewBag.SelectedCity == "danang")">Đà Nẵng</option>
                    </select>
                </div>

                <!-- Submit Button -->
                <div class="flex items-end">
                    <button type="submit" class="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-xs transition-all shadow-md shadow-blue-600/30 flex items-center justify-center gap-2">
                        <i class="fa-solid fa-filter"></i>
                        <span>Tìm Kiếm</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Categories Bar -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        @foreach (var cat in categories)
        {
            <a asp-controller="Home" asp-action="Index" asp-route-category="@cat.Code" class="bg-white rounded-2xl p-4 border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-500 transition-all flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center text-base group-hover:bg-blue-600 group-hover:text-white transition-colors">
                    <i class="fa-solid @cat.Icon"></i>
                </div>
                <div>
                    <div class="font-bold text-xs text-slate-800">@cat.Name</div>
                    <div class="text-[10px] text-slate-400">Xem danh sách</div>
                </div>
            </a>
        }
    </div>
</section>

<!-- Properties Grid -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h2 class="text-2xl font-black text-slate-900 tracking-tight">Bất Động Sản Nổi Bật</h2>
            <p class="text-xs text-slate-500 mt-1">Tìm thấy @Model.Count sản phẩm phù hợp với tiêu chí của bạn</p>
        </div>
        <div class="flex items-center gap-2">
            <a asp-controller="Property" asp-action="MapSearch" class="px-4 py-2 rounded-xl text-xs font-bold bg-rose-50 text-rose-600 hover:bg-rose-100 transition-all flex items-center gap-1.5">
                <i class="fa-solid fa-map-location-dot"></i>
                <span>Xem trên bản đồ</span>
            </a>
        </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-3xl overflow-hidden border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group">
                <!-- Image Gallery Preview -->
                <div class="relative h-56 overflow-hidden bg-slate-100">
                    <img src="@(item.Images.FirstOrDefault() ?? "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=1200&q=80")" alt="@item.Title" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    
                    @if (!string.IsNullOrEmpty(item.Badge))
                    {
                        <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] font-black uppercase text-white shadow-sm @item.BadgeColor">
                            @item.Badge
                        </span>
                    }

                    <div class="absolute bottom-3 left-3 px-3 py-1 rounded-xl bg-slate-900/80 backdrop-blur-md text-white text-xs font-extrabold">
                        @item.PriceDisplay
                    </div>
                </div>

                <!-- Info Body -->
                <div class="p-5 flex-1 flex flex-col justify-between">
                    <div>
                        <div class="text-[11px] font-bold text-blue-600 uppercase mb-1">@item.CategoryName</div>
                        <h3 class="text-sm font-bold text-slate-900 line-clamp-2 mb-2 group-hover:text-blue-600 transition-colors">
                            <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id">@item.Title</a>
                        </h3>
                        <p class="text-xs text-slate-500 flex items-center gap-1.5 mb-4">
                            <i class="fa-solid fa-location-dot text-rose-500"></i>
                            <span class="truncate">@item.Address</span>
                        </p>
                    </div>

                    <div class="pt-4 border-t border-slate-100 space-y-3">
                        <div class="flex items-center justify-between text-xs text-slate-600">
                            <span><i class="fa-solid fa-vector-square mr-1 text-slate-400"></i>@item.AreaSqm m²</span>
                            <span><i class="fa-solid fa-bed mr-1 text-slate-400"></i>@item.Bedrooms PN</span>
                            <span><i class="fa-solid fa-bath mr-1 text-slate-400"></i>@item.Bathrooms WC</span>
                        </div>

                        <div class="flex items-center justify-between pt-2">
                            <div class="flex items-center gap-2">
                                <img src="@item.Agent.Avatar" class="w-7 h-7 rounded-full object-cover" />
                                <span class="text-xs font-bold text-slate-700">@item.Agent.Name</span>
                            </div>
                            <a asp-controller="Property" asp-action="Details" asp-route-id="@item.Id" class="px-3 py-1.5 rounded-xl bg-blue-50 text-blue-600 text-xs font-bold hover:bg-blue-600 hover:text-white transition-colors">
                                Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
