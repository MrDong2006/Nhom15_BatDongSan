@model List<Nhom15_BatDongSan.Models.Review>
@{
    ViewData["Title"] = "Đánh Giá & Nhận Xét Từ Khách Hàng";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="text-center max-w-2xl mx-auto space-y-2">
        <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold uppercase">Trải Nghiệm Thực Tế</span>
        <h1 class="text-3xl font-black text-slate-900">Đánh Giá Từ Khách Hàng Giao Dịch Thành Công</h1>
        <p class="text-xs sm:text-sm text-slate-500">100% đánh giá từ khách hàng đã mua bán, thuê nhà đất thực tế qua sàn</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center gap-1 text-amber-400 text-sm">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <h3 class="text-sm font-bold text-slate-900">Giao dịch nhanh gọn, vị trí Cần Thơ quá đắc địa</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
                "Tôi chốt căn Shophouse Vincom Cần Thơ qua sàn BĐS Việt Hub chỉ trong vòng 3 ngày. Chuyên viên Nguyễn Văn Hưng rất nhiệt tình, hỗ trợ sang tên sổ hồng ngay tại phòng công chứng."
            </p>
            <div class="pt-3 border-t border-slate-100 flex items-center gap-3">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=200&q=80" class="w-9 h-9 rounded-full object-cover" />
                <div>
                    <div class="text-xs font-bold text-slate-900">Vũ Đình Trọng</div>
                    <div class="text-[10px] text-slate-400">Doanh nhân - Cần Thơ</div>
                </div>
            </div>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center gap-1 text-amber-400 text-sm">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <h3 class="text-sm font-bold text-slate-900">Tư vấn gói vay Vietcombank cực kỳ chi tiết</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
                "Nhờ công cụ tính lãi suất trên web và bạn Nam hỗ trợ hồ sơ, vợ chồng mình đã vay mua được căn The Beverly view công viên 36ha với lãi suất ưu đãi chỉ 5.5%/năm."
            </p>
            <div class="pt-3 border-t border-slate-100 flex items-center gap-3">
                <img src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=200&q=80" class="w-9 h-9 rounded-full object-cover" />
                <div>
                    <div class="text-xs font-bold text-slate-900">BS. Nguyễn Thị Bích Ngọc</div>
                    <div class="text-[10px] text-slate-400">TP. Thủ Đức</div>
                </div>
            </div>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
            <div class="flex items-center gap-1 text-amber-400 text-sm">
                <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
            </div>
            <h3 class="text-sm font-bold text-slate-900">Đất nền ven sông Cổ Cò sổ đỏ sẵn sàng</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
                "Bản đồ số định vị GPS rất chuẩn xác, nhìn rõ vị trí cách biển Tân Trà 1km. Đã nhận sổ đỏ sang tên an toàn tuyệt đối."
            </p>
            <div class="pt-3 border-t border-slate-100 flex items-center gap-3">
                <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=200&q=80" class="w-9 h-9 rounded-full object-cover" />
                <div>
                    <div class="text-xs font-bold text-slate-900">Đặng Hoàng Khang</div>
                    <div class="text-[10px] text-slate-400">Nhà đầu tư BĐS</div>
                </div>
            </div>
        </div>
    </div>
</div>
